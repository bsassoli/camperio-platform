# Configurazione camperio-platform (spec §7). Copia in:
#   Mac:  .env (spesso non serve: assenza di ORA_* = modalità DEMO)
#   WSL:  config.env
#   VM:   /etc/camperio/camperio.env (root, chmod 600, EnvironmentFile= nelle unit)
# I valori reali li inserisce Bernardino a mano al deploy — qui SOLO placeholder.

#ORA_USER=utenza_di_servizio_sola_lettura
#ORA_PWD=
#ORA_DSN=selmora01.ad.camperiosim.com:1521/<service_name>

#CAMPERIO_DATA=/var/lib/camperio

#ANTHROPIC_API_KEY=

# --- oauth2-proxy (deploy, ADR 0010) — valori dall'app registration Entra (richieste IT, punto B) ---
#OAUTH2_PROXY_PROVIDER=oidc
#OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0
#OAUTH2_PROXY_CLIENT_ID=
#OAUTH2_PROXY_CLIENT_SECRET=
#OAUTH2_PROXY_COOKIE_SECRET=   # openssl rand -base64 32
#OAUTH2_PROXY_REDIRECT_URL=https://app-ai.camperiosim.com/oauth2/callback

# Scarica i 9 CSV holdings ETF da iShares nel repository fondi (gia' oggi
# schedulato il giovedi' alle 11 sul PC di Edoardo — questo lo sostituisce).
[Unit]
Description=Camperio - download CSV ETF benchmark (iShares)
# Dipende da docker, NON da camperio.service: `compose run --rm` si crea il suo
# container e non ha bisogno dello stack su. Con Requires=camperio.service il job
# rialzava l'intero stack (nginx e 443 compresi) sia al test-fire sia dopo un rollback.
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/camperio/deploy
TimeoutStartSec=600
ExecStart=/usr/bin/docker compose run --rm -T comitato python scarica_etf.py

# Porta su lo stack Compose al boot. Installazione: v. docs/DEPLOY.md
[Unit]
Description=Piattaforma Camperio (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/camperio/deploy
TimeoutStartSec=0
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
